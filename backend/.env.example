# Copy this file to .env and fill in your values

# Gmail OAuth2
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Slack OAuth v2 — one Slack App (api.slack.com, "Distribution" enabled), installed
# per-organisation via /auth/slack/connect. Bot scopes: channels:history channels:read
# users:read users:read.email
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/auth/slack/callback

# Speech-to-text for voice messages (Slack/Teams) — faster-whisper, runs locally.
# Model size trades accuracy for speed/RAM: tiny/base/small/medium/large-v3
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# JWT auth — sign login tokens. Must be a long random secret in any real deployment.
SECRET_KEY=

# Encrypts connected-app tokens (Gmail/Outlook/Teams/Jira/...) at rest in the DB.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required — without it, connecting a source will fail. Never commit this value,
# and never let it be the same value as SECRET_KEY (different blast radius if leaked).
TOKEN_ENCRYPTION_KEY=
